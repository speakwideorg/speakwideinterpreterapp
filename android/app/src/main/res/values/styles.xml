<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!-- Custom Theme for react-native-image-crop-picker (uCrop) -->
    <style name="ucrop_Theme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Custom Toolbar style to push X, Edit Photo title, and tick buttons safely below status bar and camera notch -->
    <style name="ucrop_Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:paddingTop">48dp</item>
        <item name="android:minHeight">108dp</item>
    </style>
</resources>
