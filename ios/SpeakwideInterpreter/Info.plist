	<string>Allows you to select photos to upload within the app.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This app includes third-party libraries that may access Bluetooth. No Bluetooth data is collected.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
